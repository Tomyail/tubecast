{
  "expo": {
    "name": "TubeCast",
    "slug": "tubecast",
    "owner": "tomyail",
    "scheme": "tubecast",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tomyail.tubecast",
      "appStoreUrl": "https://apps.apple.com/app/id6783834717?action=write-review",
      "buildNumber": "14",
      "deploymentTarget": "18.0",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tomyail.tubecast",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      "expo-localization",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "18.0"
          }
        }
      ],
      "./plugins/withShareExtension.cjs"
    ],
    "extra": {
      "eas": {
        "projectId": "7be65898-e040-4536-a2c8-514bcd251567",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "TubeCastShareExtension",
                  "bundleIdentifier": "com.tomyail.tubecast.ShareExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.tomyail.tubecast"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
