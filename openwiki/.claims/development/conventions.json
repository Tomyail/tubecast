    {
      "id": "claim_2bb404b25b5040bdb0372a00372293d8",
      "statement": "scripts/commit-type-guard.mjs only inspects feat/fix commits: it lists staged files (git diff --cached --name-only --diff-filter=ACM) and classifies each as tooling (scripts/, fastlane/, .github/, .husky/, docs/, ios/, android/, root configs, and md/mjs/cjs/yml/yaml/toml/rb/lock/snap/plist extensions) or app source; it rejects the commit (exit 1 with corrective suggestions) only when every staged file is tooling, and passes when any app-source file is staged or the staged list is unreadable/empty.",
      "evidence": [
        {
          "resource": "repo://scripts/commit-type-guard.mjs#L29-L79",
          "version": "repo-lines-v1:sha256:8378d6a481e88b16870dc26f6d7c98862892f7a4350af4ef57815c4ce74142ba:"
        }
      ]
    },
