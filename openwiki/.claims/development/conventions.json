      "id": "claim_b02838fddaf749849c5deea84f6f4218",
      "statement": "commitlint.config.cjs extends @commitlint/config-conventional and pins type-enum to feat/fix/perf/refactor/revert/docs/style/test/build/ci/chore, disables subject-case (allowing Chinese/capitalized subjects), enforces header-max-length 100, and ignores Merge/Revert/Initial-commit messages.",
      "evidence": [
        {
          "resource": "repo://commitlint.config.cjs",
          "version": "repo-file-v1:sha256:3c76ffbb005b1a8d169d47cb6391c1548a800609ad2d7b2948ba305cc6942196"
        }
